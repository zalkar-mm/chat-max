# Пример переменных окружения Vite. Скопируйте в `.env.local` (он в .gitignore) и поправьте.
# Креды GREEN-API (idInstance, apiTokenInstance) в env не кладутся: их вводят на экране входа.

# true — dev-сервер работает на моках MSW вместо реального GREEN-API (src/mocks/README.md).
VITE_API_MOCKS=false
